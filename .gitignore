# typecheck without first running the backend.
openapi.json

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Playwright transient reports (committed demo media lives under docs/assets/)
test-results/
playwright-report/

# IDE / tool config (not project code)
.serena/

# Private hackathon planning, session context, AI-generated notes —
# never commit. Local tracking only.
CODEAMBLE_2026_PRIVATE/
