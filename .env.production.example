# Production secrets for docker-compose.yml.
# Copy to .env.production and fill in real values. Never commit the filled file.

POSTGRES_PASSWORD=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BHARAT_OS_ENCRYPTION_KEY=

# Comma-separated, the real frontend origin(s), no wildcard.
BHARAT_OS_CORS_ALLOWED_ORIGINS=https://your-domain.example

BHARAT_OS_LLM_PROVIDER=gemini
BHARAT_OS_GEMINI_API_KEY=
BHARAT_OS_GEMINI_MODEL=gemini-2.5-pro

NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example
