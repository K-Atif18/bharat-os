# Bharat OS configuration.
# Copy to .env and fill in. Never commit .env.
# All backend settings are prefixed BHARAT_OS_.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development and tests. Peer authentication over the Unix socket means no
# password appears in this file:
BHARAT_OS_DATABASE_URL=postgresql+psycopg:///bharat_os
# Fallback with no database server required (not supported in production):
# BHARAT_OS_DATABASE_URL=sqlite:///./bharat_os.db

# Tests run against this instead, if set. Defaults to the Postgres URL above.
# BHARAT_OS_TEST_DATABASE_URL=sqlite:///./test.db

# ---------------------------------------------------------------------------
# Encryption at rest for sensitive profile fields (annual turnover, social
# category). Required — the app refuses to start without it in production.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
BHARAT_OS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Environment: development | test | production
# ---------------------------------------------------------------------------
BHARAT_OS_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Scheme data freshness. Criteria not re-verified within this many days are
# surfaced to users as potentially stale.
# ---------------------------------------------------------------------------
BHARAT_OS_STALENESS_THRESHOLD_DAYS=90

# ---------------------------------------------------------------------------
# LLM provider. mock is deterministic and makes no network calls — the whole
# test suite runs against it. Switch to gemini for real soft-criteria
# reasoning and application drafting.
# ---------------------------------------------------------------------------
BHARAT_OS_LLM_PROVIDER=mock
BHARAT_OS_GEMINI_API_KEY=
BHARAT_OS_GEMINI_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# CORS. Comma-separated. Credentials are sent with every request, so this must
# be an explicit list, never a wildcard.
# ---------------------------------------------------------------------------
BHARAT_OS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Optional error tracking. Leave blank to disable — nothing else depends on it.
# ---------------------------------------------------------------------------
BHARAT_OS_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
